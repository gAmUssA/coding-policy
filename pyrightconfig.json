{
  "include": [
    "scripts",
    "skills",
    "hooks"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__"
  ],
  "typeCheckingMode": "standard",
  "strict": [
    "hooks",
    "scripts",
    "skills/herdr-standup"
  ],
  "pythonVersion": "3.11",
  "executionEnvironments": [
    {
      "root": "skills/herdr-teamlead",
      "extraPaths": [
        "skills/herdr-teamlead"
      ]
    },
    {
      "root": "skills/herdr-standup",
      "extraPaths": [
        "skills/herdr-standup"
      ]
    }
  ]
}
