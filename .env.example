# GitHub Actions secrets required by workflows in this repo.
# Configure all of them here:
#   https://github.com/gAmUssA/coding-policy/settings/secrets/actions

# Required by .github/workflows/publish.yml and the lint job in
# .github/workflows/tests.yml — Tessl plugin publishing and `tessl plugin lint`.
# Get this from your Tessl account: https://app.tessl.io/
TESSL_TOKEN=

# Required by .github/workflows/review-codex.yml — the Codex CLI policy
# reviewer authenticates with a ChatGPT subscription (no API key). Create the
# token once with `codex login` on a trusted machine, then store the FULL
# contents of ~/.codex/auth.json here (a non-empty tokens.refresh_token;
# auth_mode "chatgpt" or absent). Re-seed it whenever the review fails on expired
# auth. Log in under a throwaway CODEX_HOME so a local Codex refresh never spends
# the secret's refresh token:
#   export CODEX_HOME=$(mktemp -d) && codex login && gh secret set CODEX_AUTH_JSON --repo github.com/gAmUssA/coding-policy < "$CODEX_HOME/auth.json"; rm -rf "$CODEX_HOME"; unset CODEX_HOME
# See https://learn.chatgpt.com/docs/auth/ci-cd-auth
CODEX_AUTH_JSON=

# Required by .github/workflows/review-claude.yml — the Claude code-quality
# reviewer authenticates with a Claude subscription (no API key). Create the
# token on a trusted machine with `claude setup-token`, then store it here.
# Re-seed it whenever the review fails on rejected authentication:
#   gh secret set CLAUDE_CODE_OAUTH_TOKEN --repo github.com/gAmUssA/coding-policy
CLAUDE_CODE_OAUTH_TOKEN=

# Copilot (the advisory reviewer being replaced by Claude) needs no secret.

# Optional local Herdr round setting; required only when
# skills/herdr-teamlead/review-package.sh omits OUTFILE. Set this yourself to
# the round's writable reports directory. Not a credential or a GitHub secret.
TEAMLEAD_REPORTS_DIR=

# Herdr supplies these to its native panes. Required for live lead supervision
# binding and its exact-session Stop check; offline saved-state commands need
# neither. Launch the lead inside Herdr to obtain them; never guess a pane ID.
# Not credentials or GitHub Actions secrets.
HERDR_ENV=
HERDR_PANE_ID=
