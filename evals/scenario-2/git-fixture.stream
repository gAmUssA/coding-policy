#!/usr/bin/env bash
# assemble-release.sh
#
# Called by the publish workflow on push to main.
# - Reads all changelog.d/<name>.md fragments (excluding README.md)
# - Determines the highest bump level (major > minor > patch)
# - Bumps plugin.json version accordingly
# - Prepends a ## <version> — <date> heading to CHANGELOG.md with merged fragment bodies
# - Deletes the assembled fragments
# - Commits the result as chore(release): <version>
#
# This script runs in CI. Do NOT run it manually during development.
# To record a release entry, add a fragment to changelog.d/ instead.

set -euo pipefail
echo "This script is run by CI on merge to main. Do not invoke manually." >&2
exit 0

